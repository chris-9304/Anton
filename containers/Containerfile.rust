# Headless CLI/API builds do not compile or link the desktop toolkit.
FROM rust:1-bookworm AS builder
WORKDIR /build
COPY Cargo.toml Cargo.lock build.rs ./
COPY src ./src
RUN cargo build --locked --release --no-default-features --bin anton --bin anton_api --bin demo_ransomware

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libgcc-s1 && rm -rf /var/lib/apt/lists/*
COPY --from=builder /build/target/release/anton /usr/local/bin/anton
COPY --from=builder /build/target/release/anton_api /usr/local/bin/anton_api
COPY --from=builder /build/target/release/demo_ransomware /usr/local/bin/demo_ransomware
COPY containers/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["api"]
